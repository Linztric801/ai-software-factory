# AI Software Factory: copy to deploy/.env and fill in. Placeholders only.
# With AUTH_MODE=none and nothing else set, the factory runs without login
# and listens on 127.0.0.1 only.

FACTORY_NAME="AI Software Factory"
PUBLIC_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080

# Authentication: none | entra
AUTH_MODE=none
# Required to listen on a non-private address without login. Leave false.
ALLOW_UNAUTHENTICATED_NETWORK=false
# Microsoft Entra ID (set all three, then AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Data
DATABASE_URL=postgresql://factory:CHANGE_ME@postgres:5432/factory
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
ARTIFACT_STORE=fs
ARTIFACT_DIR=/data/artifacts

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored secrets.
FACTORY_SECRET_KEY=

# Agents: given to the egress proxy only, never to run sandboxes
ANTHROPIC_API_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Theme pack directory (the default theme ships with this repo)
THEME_PACK_DIR=/themes/default

# Worker
WORKER_LABELS=linux
WORKER_TOKEN=
