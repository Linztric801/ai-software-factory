#!/usr/bin/env python3
"""Serve the festival dashboard for the project in the working directory.

Usage: party-dashboard [port] [--demo]    (default 8765; listens on 127.0.0.1 only)

  /        the dashboard, rendered from the project's jobs
  /live    the parts of the page that change, as JSON (the page polls it)
  /jobs/   the raw job files

--demo shows clearly labelled sample data instead of the project's jobs, for
screenshots and presentations. Stop with Ctrl-C.
"""

import functools
import http.server
import json
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib"))
from party import Project  # noqa: E402
import world  # noqa: E402


def read_jobs(jobs_dir):
    jobs = []
    for folder in sorted(jobs_dir.iterdir()) if jobs_dir.exists() else []:
        try:
            jobs.append(json.loads((folder / "job.json").read_text()))
        except (OSError, json.JSONDecodeError):
            continue  # a job being written right now; the next poll sees it
    return jobs


class Handler(http.server.SimpleHTTPRequestHandler):
    """The page and its live regions from world.py; jobs/ from the project's state folder.

    Answers only requests addressed to this server by its loopback name, so a web
    page can't read the jobs through DNS rebinding, and serves no file outside
    the project's jobs/ folder."""

    allowed_hosts = set()
    project = None
    demo = False
    theme = None

    def state(self):
        if self.demo:
            return world.demo_jobs(), {"approvers": ["yusuf", "stefan"]}, "Demo project"
        return read_jobs(self.project.jobs), self.project.config, self.project.slug

    def do_HEAD(self):
        self.route(head=True)

    def do_GET(self):
        self.route()

    def route(self, head=False):
        """Every method goes through here, so the Host check covers all of them."""
        self.head = head
        if self.headers.get("Host", "") not in self.allowed_hosts:
            self.send_error(403, "Wrong host")
            return
        path = self.path.split("?", 1)[0].split("#", 1)[0]
        if path in ("/", "/index.html"):
            jobs, settings, name = self.state()
            return self.reply(world.page(jobs, settings, self.theme, name, self.demo), "text/html; charset=utf-8")
        if path == "/live":
            jobs, settings, name = self.state()
            return self.reply(json.dumps(world.regions(jobs, settings, self.theme, name, self.demo)), "application/json")
        if path.startswith("/jobs/") and not self.demo:
            return super().do_HEAD() if head else super().do_GET()
        self.send_error(404)

    def reply(self, body, kind):
        data = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if not self.head:
            self.wfile.write(data)

    def translate_path(self, path):
        target = Path(super().translate_path(path)).resolve()
        if not target.is_relative_to(self.project.jobs.resolve()):
            return str(self.project.jobs / "missing")
        return str(target)

    def log_message(self, *args):
        pass


def main(argv):
    demo = "--demo" in argv
    args = [a for a in argv if a != "--demo"]
    port = int(args[0]) if args else 8765
    project = Project()
    project.jobs.mkdir(parents=True, exist_ok=True)
    Handler.allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    Handler.project = project
    Handler.demo = demo
    Handler.theme = world.load_theme(project.config.get("theme", "cloudfest"))
    handler = functools.partial(Handler, directory=str(project.dir))
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), handler)
    print(f"{Handler.theme.get('product', 'AI Software Factory')}{' (demo)' if demo else ''}: "
          f"http://127.0.0.1:{port}/", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main(sys.argv[1:])
