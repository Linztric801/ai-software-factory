#!/usr/bin/env python3
"""A Claude Code sandbox profile for the factory's agents in this project.

Usage:
  party-sandbox            print the profile for the project in the working directory
  party-sandbox --write    merge it into <repo>/.claude/settings.local.json (machine-local)
  party-sandbox --off      remove it again

With the sandbox on, every Bash command Claude runs in this project, the
factory's agents' included, may write only to the project, the factory's
state folder and build caches; can't read SSH keys or cloud credentials; and
reaches only GitHub, the npm registry, Anthropic and the domains the project
lists under `sandbox.allowed_domains` in .factory/config.json as merged on the
base branch. GitHub access itself stays available, because the builder pushes
and opens PRs.

Only the factory's own hosts go into the user settings' strict allowlist; a
project's extra domains stay in that project's settings.
"""

import json
import re
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib"))
from party import Project, home  # noqa: E402

DOMAINS = ["github.com", "api.github.com", "codeload.github.com", "*.githubusercontent.com",
           "registry.npmjs.org", "*.npmjs.org", "api.anthropic.com"]
WRITABLE = ["~/Library/pnpm", "~/.local/share/pnpm", "~/.cache", "~/Library/Caches",
            "~/Library/Developer", "~/Library/Logs/CoreSimulator", "~/Library/org.swift.swiftpm",
            "/tmp", "/private/tmp", "/var/folders", "/private/var/folders"]  # Xcode's temp and caches
SECRETS = ["~/.ssh", "~/.aws", "~/.config/gcloud", "~/.azure", "~/.kube", "~/.docker/config.json", "~/.netrc"]


DOMAIN = re.compile(r"(\*\.)?([a-z0-9-]+\.)+[a-z]{2,}")


def extra_domains(project):
    """A project's extra hosts, from its reviewed config; no `*`, no bare TLD wildcards."""
    extra = (project.committed_config().get("sandbox") or {}).get("allowed_domains") or []
    bad = [d for d in extra if not (isinstance(d, str) and DOMAIN.fullmatch(d)
                                    and d.removeprefix("*.").count(".") >= 1)]
    if bad:
        print(f"party-sandbox: not a domain the sandbox may allow: {', '.join(map(str, bad))}", file=sys.stderr)
        sys.exit(1)
    return [d for d in extra if d not in DOMAINS]


def profile(project):
    extra = extra_domains(project)
    return {
        "enabled": True,
        "allowUnsandboxedCommands": False,  # no per-command way out of the sandbox
        "filesystem": {"allowWrite": [str(home()), *WRITABLE]},
        "credentials": {"files": [{"path": p, "mode": "deny"} for p in SECRETS]},
        "network": {
            "allowedDomains": DOMAINS + extra,
            "allowLocalBinding": True,                       # dev servers for UI checks
            "allowUnixSockets": ["/private/var/tmp", "/var/tmp"],  # the simulator's test runner
            "allowMachLookup": ["com.apple.CoreSimulator.*", "com.apple.coresimulator.*",  # the iOS simulator
                                "com.apple.dt.*",
                                "com.apple.SecurityServer", "com.apple.securityd.xpc",  # gh's keychain login
                                "com.apple.trustd", "com.apple.trustd.agent"],          # TLS checks for gh and git
        },
    }


USER_SETTINGS = Path.home() / ".claude" / "settings.json"


def strict_network(domains, on=True):
    """The sandbox enforces an allowlist strictly only from user settings. It applies
    only to projects whose sandbox is on; elsewhere nothing changes."""
    settings = json.loads(USER_SETTINGS.read_text()) if USER_SETTINGS.exists() else {}
    net = settings.setdefault("sandbox", {}).setdefault("network", {})
    if on:
        net["strictAllowlist"] = True
        net["allowedDomains"] = sorted(set(net.get("allowedDomains", [])) | set(domains))
    USER_SETTINGS.write_text(json.dumps(settings, indent=2) + "\n")


def main(argv):
    project = Project()
    settings_file = project.repo / ".claude" / "settings.local.json"
    if not argv:
        print(json.dumps({"sandbox": profile(project)}, indent=2))
        return
    current = json.loads(settings_file.read_text()) if settings_file.exists() else {}
    if argv == ["--write"]:
        current["sandbox"] = profile(project)
        strict_network(DOMAINS)
        extra = extra_domains(project)
        message = (f"sandbox on for {project.slug}: {settings_file}"
                   + (f"; also allows {', '.join(extra)}" if extra else ""))
    elif argv == ["--off"]:
        current.pop("sandbox", None)
        message = f"sandbox off for {project.slug}"
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    settings_file.parent.mkdir(exist_ok=True)
    settings_file.write_text(json.dumps(current, indent=2) + "\n")
    print(message + ". Restart Claude Code in this project to apply it.")


if __name__ == "__main__":
    main(sys.argv[1:])
