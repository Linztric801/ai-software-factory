#!/usr/bin/env python3
"""Map intake's risk and surfaces to the job's agent set.

Usage: party-route <job-id>

Reads `risk` and `surfaces` from intake.md (through job.json), looks them up in
the factory settings' `routing` and `surface_reviewers` tables, and records the
result in job.json with `party-job agents`. Prints the agent set.
"""

import json
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib"))
from party import Project  # noqa: E402

PROJECT = Project()
CONFIG = PROJECT.config


def die(msg):
    print(f"route: {msg}", file=sys.stderr)
    sys.exit(1)


def main(argv):
    if len(argv) != 1:
        die("usage: route <job-id>")
    job_id = argv[0]
    job_bin = str(BIN / "party-job")
    res = subprocess.run([job_bin, "sync", job_id], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    job = json.loads((PROJECT.jobs / job_id / "job.json").read_text())
    intake = job["intake"] or die(f"{job_id} has no intake.md")
    risk = CONFIG["routing"].get(intake["risk"]) or die(
        f"risk {intake['risk']!r} isn't in the settings' routing ({', '.join(CONFIG['routing'])})")
    reviewers = dict(risk)
    for surface in intake["surfaces"]:
        extra = CONFIG["surface_reviewers"].get(surface)
        if extra is None:
            die(f"surface {surface!r} isn't in the settings' surface_reviewers ({', '.join(CONFIG['surface_reviewers'])})")
        reviewers.update(extra)
    agents = {"reviewers": reviewers}
    res = subprocess.run([job_bin, "agents", job_id, json.dumps(agents)], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    print(f"{job_id}: reviewers " + ", ".join(f"{k} {v}" for k, v in reviewers.items()))


if __name__ == "__main__":
    main(sys.argv[1:])
